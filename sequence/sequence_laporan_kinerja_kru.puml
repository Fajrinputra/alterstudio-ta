@startuml
title Sequence Diagram Melihat Laporan Kinerja Kru

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    BoxBorderColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
    DividerBorderColor #999999
    DividerFontColor #111111
}

actor "Manajer" as Manajer
actor "Owner" as Owner
boundary "Halaman Laporan" as HalamanLaporan
boundary "Filter Laporan" as FilterLaporan
control "ReportController" as ReportController
entity "Bookings Model" as Booking
entity "Payments Model" as Payment
entity "Projects Model" as Project
entity "ProjectSchedules Model" as ProjectSchedule
entity "Users Model" as User
entity "ServicePackages Model" as ServicePackage

alt Manajer membuka laporan
    Manajer -> HalamanLaporan : Mengklik menu laporan
    HalamanLaporan -> ReportController : request halaman laporan
    ReportController --> HalamanLaporan : tampilkan halaman laporan
    HalamanLaporan --> Manajer : Halaman laporan tampil
else Owner membuka laporan
    Owner -> HalamanLaporan : Mengklik menu laporan
    HalamanLaporan -> ReportController : request halaman laporan
    ReportController --> HalamanLaporan : tampilkan halaman laporan
    HalamanLaporan --> Owner : Halaman laporan tampil
end

alt Manajer memilih filter
    Manajer -> FilterLaporan : memilih periode dan kategori
    FilterLaporan -> ReportController : index(periode, kategori)
else Owner memilih filter
    Owner -> FilterLaporan : memilih periode
    FilterLaporan -> ReportController : index(periode)
end

ReportController -> ReportController : validasi filter laporan

alt Filter valid
    ReportController -> Booking : ambil data pemesanan berdasarkan filter
    Booking --> ReportController : collection booking
    ReportController -> Payment : ambil data pembayaran berhasil
    Payment --> ReportController : collection payment
    ReportController -> Project : ambil data project
    Project --> ReportController : collection project
    ReportController -> ProjectSchedule : ambil jadwal dan penugasan kru
    ProjectSchedule --> ReportController : collection jadwal kru
    ReportController -> User : ambil data kru fotografer/editor
    User --> ReportController : collection user
    ReportController -> ServicePackage : ambil data paket/kategori layanan
    ServicePackage --> ReportController : collection paket
    ReportController -> ReportController : hitung total pemesanan
    ReportController -> ReportController : hitung total pendapatan
    ReportController -> ReportController : hitung status pembayaran
    ReportController -> ReportController : hitung keterlibatan fotografer dan editor

    alt Role Owner
        ReportController -> ReportController : batasi filter hanya berdasarkan periode
        ReportController -> ReportController : hitung laporan final/detail
        ReportController --> HalamanLaporan : tampilkan laporan owner
        HalamanLaporan --> Owner : Laporan tampil
    else Role Manajer
        ReportController -> ReportController : olah laporan berdasarkan periode/kategori
        ReportController --> HalamanLaporan : tampilkan laporan manajer
        HalamanLaporan --> Manajer : Laporan tampil
    end
else Filter / rentang tanggal tidak valid
    ReportController --> HalamanLaporan : tampilkan pesan error
    HalamanLaporan --> Manajer : filter tidak valid
    HalamanLaporan --> Owner : filter tidak valid
else Data periode tidak tersedia
    ReportController --> HalamanLaporan : tampilkan laporan kosong
    HalamanLaporan --> Manajer : laporan kosong tampil
    HalamanLaporan --> Owner : laporan kosong tampil
end

@enduml
