@startuml
title SD-B32 Edit Cabang Studio

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Owner" as Owner
boundary "Detail Cabang" as DetailCabang
boundary "Form Edit Cabang" as FormEdit
control "StudioLocationController" as StudioLocationController
control "StorageService" as StorageService
entity "StudioLocations Model" as StudioLocation

Owner -> DetailCabang : Klik edit cabang
DetailCabang -> StudioLocationController : edit(location_code)
StudioLocationController -> StudioLocation : ambil detail cabang\nbeserta ruangan
StudioLocation --> StudioLocationController : data cabang dan ruangan
StudioLocationController --> FormEdit : tampilkan form edit\n(foto galeri existing ditampilkan)
Owner -> FormEdit : Ubah data cabang
FormEdit -> StudioLocationController : update(location_code, data)
StudioLocationController -> StudioLocationController : validasi data perubahan

alt Data valid
    opt Nama cabang berubah
        StudioLocationController -> StudioLocationController : regenerate slug\ndari nama baru
    end
    StudioLocationController -> StudioLocation : UPDATE studio_locations\nberdasarkan location_code
    StudioLocation --> StudioLocationController : cabang diperbarui
    opt Foto baru diunggah
        StudioLocationController -> StorageService : simpan foto baru ke\nstorage/public/locations/{id}
        StorageService --> StudioLocationController : path foto baru
        StudioLocationController -> StudioLocation : syncPhotos — append foto baru\nke galeri yang sudah ada
        StudioLocation --> StudioLocationController : galeri diperbarui
    end
    StudioLocationController -> StudioLocationController : Cache::forget\n('landing.page.data.v2')
    StudioLocationController --> DetailCabang : redirect pesan sukses
    DetailCabang --> Owner : detail cabang terbaru tampil
else Data tidak valid / gagal simpan
    StudioLocationController --> FormEdit : tampilkan pesan error
    FormEdit --> Owner : perubahan tidak diterapkan
end

note right of StudioLocationController
  Foto galeri yang sudah ada dipertahankan.
  Hapus foto per-item dilakukan melalui SD-B33.
end note

@enduml
