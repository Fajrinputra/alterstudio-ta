@startuml
title SD-B32 Edit Cabang Studio

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Owner" as Owner
boundary "Detail Cabang" as DetailCabang
boundary "Form Edit Cabang" as FormEdit
control "StudioLocationController" as StudioLocationController
entity "StudioLocations Model" as StudioLocation
entity "StudioRooms Model" as StudioRoom

Owner -> DetailCabang : Klik edit cabang
DetailCabang -> StudioLocationController : edit(locationId)
StudioLocationController -> StudioLocation : ambil detail cabang
StudioLocation --> StudioLocationController : data cabang
StudioLocationController -> StudioRoom : ambil ruangan cabang
StudioRoom --> StudioLocationController : data ruangan
StudioLocationController --> FormEdit : tampilkan form edit
Owner -> FormEdit : Ubah data cabang dan ruangan
FormEdit -> StudioLocationController : update(locationId, data)
StudioLocationController -> StudioLocationController : validasi data perubahan

alt Data valid
    StudioLocationController -> StudioLocation : UPDATE studio_locations
    StudioLocation --> StudioLocationController : cabang diperbarui
    StudioLocationController -> StudioRoom : UPDATE/INSERT studio_rooms
    StudioRoom --> StudioLocationController : ruangan diperbarui
    StudioLocationController --> DetailCabang : redirect pesan sukses
    DetailCabang --> Owner : detail cabang terbaru tampil
else Data tidak valid / gagal simpan
    StudioLocationController --> FormEdit : tampilkan pesan error
    FormEdit --> Owner : perubahan tidak diterapkan
end

@enduml
