@startuml
title SD-B41 Tambah Hero Landing Page

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Manajer" as Manajer
boundary "Halaman Kelola Hero" as HalamanHero
boundary "Form Tambah Slide Hero" as FormTambah
control "LandingHeroController" as LandingHeroController
control "StorageService" as StorageService
entity "LandingHeroSlides Model" as LandingHeroSlide

Manajer -> HalamanHero : Membuka halaman kelola hero
HalamanHero -> FormTambah : tampilkan form tambah slide
Manajer -> FormTambah : Submit data slide dan gambar
FormTambah -> LandingHeroController : store(data)
LandingHeroController -> LandingHeroController : validasi teks, urutan,\nstatus, dan gambar

alt Validasi berhasil
    LandingHeroController -> StorageService : simpan gambar hero
    StorageService -> StorageService : STORE landing/hero image
    StorageService --> StorageService : image path
    StorageService --> LandingHeroController : image path
    LandingHeroController -> LandingHeroSlide : INSERT landing_hero_slides
    LandingHeroSlide --> LandingHeroController : slide tersimpan
    LandingHeroController --> HalamanHero : redirect dengan pesan berhasil
    HalamanHero --> Manajer : slide baru tampil pada daftar hero
else Validasi gagal
    LandingHeroController --> FormTambah : tampilkan pesan error
    FormTambah --> Manajer : data slide tidak tersimpan
end

@enduml
