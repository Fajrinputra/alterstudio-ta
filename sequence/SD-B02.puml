@startuml
title SD-B02 Lihat Rules

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
}

actor "Pengunjung/Klien" as Pengunjung
boundary "Halaman Landing / Klien" as Halaman
boundary "Tombol Rules" as TombolRules
boundary "Modal Rules" as ModalRules
control "RulesComponent" as RulesComponent

Pengunjung -> Halaman : Berada pada halaman
Pengunjung -> TombolRules : Menekan ikon rules
TombolRules -> RulesComponent : openRules()
RulesComponent --> ModalRules : tampilkan isi rules
ModalRules --> Pengunjung : Rules tampil dalam modal

@enduml
