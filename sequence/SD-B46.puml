@startuml
title SD-B46 Lihat Ruangan Studio

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Owner" as Owner
boundary "Menu Ruangan" as MenuRuangan
boundary "Halaman Ruangan Studio" as HalamanRuangan
control "StudioRoomController" as StudioRoomController
entity "StudioRooms Model" as StudioRoom

Owner -> MenuRuangan : Membuka menu ruangan
MenuRuangan -> StudioRoomController : index()
StudioRoomController -> StudioRoom : SELECT studio_rooms dengan\nroom_code dan location_code
StudioRoom --> StudioRoomController : data ruangan
StudioRoomController --> HalamanRuangan : tampilkan daftar ruangan

alt Data tersedia
    HalamanRuangan --> Owner : daftar ruangan tampil
else Data kosong
    HalamanRuangan --> Owner : daftar ruangan kosong
else Gagal load data
    StudioRoomController --> HalamanRuangan : tampilkan pesan error
    HalamanRuangan --> Owner : error ditampilkan
end

@enduml
