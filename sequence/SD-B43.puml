@startuml
title SD-B43 Hapus Hero Landing Page

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Manajer" as Manajer
boundary "Halaman Kelola Hero" as HalamanHero
boundary "Modal Hapus Slide Hero" as ModalHapus
control "LandingHeroController" as LandingHeroController
control "StorageService" as StorageService
entity "LandingHeroSlides Model" as LandingHeroSlide

Manajer -> HalamanHero : Klik hapus pada slide hero
HalamanHero -> ModalHapus : tampilkan modal konfirmasi hapus
Manajer -> ModalHapus : konfirmasi hapus slide
ModalHapus -> LandingHeroController : destroy(slide_code)
LandingHeroController -> LandingHeroSlide : SELECT landing_hero_slides\nberdasarkan slide_code
LandingHeroSlide --> LandingHeroController : data slide

alt Slide ditemukan
    LandingHeroController -> StorageService : hapus file gambar hero
    StorageService -> StorageService : DELETE image_path
    StorageService --> StorageService : file terhapus
    StorageService --> LandingHeroController : file terhapus
    LandingHeroController -> LandingHeroSlide : DELETE landing_hero_slides\nberdasarkan slide_code
    LandingHeroSlide --> LandingHeroController : slide terhapus
    LandingHeroController --> HalamanHero : redirect dengan pesan berhasil
    HalamanHero --> Manajer : daftar slide hero diperbarui
else Slide tidak ditemukan
    LandingHeroController --> ModalHapus : tampilkan pesan error
    ModalHapus --> Manajer : slide tidak ditemukan
end

@enduml
