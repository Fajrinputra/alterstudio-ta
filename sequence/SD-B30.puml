@startuml
title SD-B30 Lihat Menu Cabang Studio

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
}

actor "Owner" as Owner
boundary "Menu Cabang" as MenuCabang
boundary "Halaman Cabang Studio" as HalamanCabang
control "StudioLocationController" as LocationController
entity "StudioLocations Model" as StudioLocation
entity "StudioRooms Model" as StudioRoom

Owner -> MenuCabang : Membuka menu cabang
MenuCabang -> LocationController : index/manage()
LocationController -> StudioLocation : ambil daftar cabang studio\nberdasarkan location_code
StudioLocation --> LocationController : data cabang
LocationController -> StudioRoom : hitung jumlah ruangan per location_code
StudioRoom --> LocationController : ringkasan ruangan
LocationController --> HalamanCabang : tampilkan daftar cabang
HalamanCabang --> Owner : menu cabang studio tampil

@enduml
