@startuml
title SD-B09 Edit Profil

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Pengguna" as Pengguna
boundary "Halaman Profil" as HalamanProfil
boundary "Form Edit Profil" as FormEdit
control "ProfileController" as ProfileController
control "StorageService" as StorageService
entity "Users Model" as User

Pengguna -> HalamanProfil : Menekan tombol edit profil
HalamanProfil -> FormEdit : tampilkan form edit profil
FormEdit --> Pengguna : form edit profil tampil
Pengguna -> FormEdit : Mengubah data profil
Pengguna -> FormEdit : Klik simpan
FormEdit -> ProfileController : update(data profil)
ProfileController -> ProfileController : validasi data dan otorisasi

alt Data valid
    opt Avatar diunggah
        ProfileController -> StorageService : simpan avatar
        StorageService -> StorageService : STORE file avatar
        StorageService --> StorageService : avatar path
        StorageService --> ProfileController : avatar path
    end
    opt Email berubah
        ProfileController -> ProfileController : set email_verified_at sesuai aturan sistem
    end
    ProfileController -> User : update profil
    User --> ProfileController : update berhasil
    ProfileController --> HalamanProfil : redirect dengan pesan berhasil
    HalamanProfil --> Pengguna : profil berhasil diperbarui
else Data tidak valid / gagal otorisasi
    ProfileController --> FormEdit : tampilkan error validasi
    FormEdit --> Pengguna : perbaiki data profil
end

@enduml
