@startuml
title SD-B42 Edit Hero Landing Page

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Manajer" as Manajer
boundary "Halaman Kelola Hero" as HalamanHero
boundary "Form Edit Slide Hero" as FormEdit
control "LandingHeroController" as LandingHeroController
control "StorageService" as StorageService
entity "LandingHeroSlides Model" as LandingHeroSlide

Manajer -> HalamanHero : Klik edit pada slide hero
HalamanHero -> LandingHeroController : edit(slide_code)
LandingHeroController -> LandingHeroSlide : SELECT landing_hero_slides\nberdasarkan slide_code
LandingHeroSlide --> LandingHeroController : data slide
LandingHeroController --> FormEdit : tampilkan form edit slide\n(view: admin.landing.hero.edit)
FormEdit --> Manajer : form edit tampil

note right of FormEdit
  Sort order TIDAK ditampilkan\ndi form edit dan tidak bisa diubah.\nUrutan slide dikelola otomatis.
end note

Manajer -> FormEdit : Ubah judul, subtitle, eyebrow,\nstatus aktif, dan/atau foto
FormEdit -> LandingHeroController : update(slide_code, data)
LandingHeroController -> LandingHeroController : validasi data perubahan

alt Validasi berhasil
    opt Gambar baru diunggah
        LandingHeroController -> StorageService : hapus gambar lama dari storage
        StorageService --> LandingHeroController : file lama terhapus
        LandingHeroController -> StorageService : simpan gambar baru ke\nstorage/public/landing/hero
        StorageService --> LandingHeroController : image_path baru
    end
    LandingHeroController -> LandingHeroSlide : UPDATE landing_hero_slides\nberdasarkan slide_code
    LandingHeroSlide --> LandingHeroController : slide diperbarui
    LandingHeroController -> LandingHeroController : Cache::forget\n('landing.page.data.v2')
    LandingHeroController --> HalamanHero : redirect dengan pesan berhasil
    HalamanHero --> Manajer : slide hero terbaru tampil
else Validasi gagal
    LandingHeroController --> FormEdit : tampilkan pesan error
    FormEdit --> Manajer : perubahan tidak disimpan
end

@enduml
