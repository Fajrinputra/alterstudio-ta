@startuml
title SD-B26 Lihat Jadwal Tugas

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Admin/Fotografer/Editor" as Pengguna
boundary "Menu Jadwal" as MenuJadwal
boundary "Halaman Jadwal Tugas" as HalamanTugas
control "ScheduleController" as ScheduleController
entity "ProjectSchedules Model" as ProjectSchedule
entity "Users Model" as User

Pengguna -> MenuJadwal : Buka jadwal
MenuJadwal -> HalamanTugas : akses halaman jadwal tugas
HalamanTugas -> ScheduleController : index(filter)

alt User adalah fotografer/editor
    ScheduleController -> User : ambil id user login
    User --> ScheduleController : user login
    ScheduleController -> ProjectSchedule : ambil jadwal berdasarkan\nphotographer_id/editor_id
    ProjectSchedule --> ScheduleController : data jadwal milik user
else User adalah admin
    ScheduleController -> ProjectSchedule : ambil seluruh jadwal tugas
    ProjectSchedule --> ScheduleController : data jadwal
end

alt Jadwal tersedia
    ScheduleController --> HalamanTugas : tampilkan daftar jadwal
    HalamanTugas --> Pengguna : jadwal tugas tampil
else Belum ada jadwal
    ScheduleController --> HalamanTugas : tampilkan daftar kosong
    HalamanTugas --> Pengguna : jadwal kosong
end

@enduml
