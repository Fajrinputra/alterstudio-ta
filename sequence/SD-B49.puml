@startuml
title SD-B49 Hapus Ruangan Studio

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Owner" as Owner
boundary "Halaman Ruangan Studio" as HalamanRuangan
boundary "Modal Konfirmasi Hapus" as ModalHapus
control "StudioRoomController" as StudioRoomController
entity "StudioRooms Model" as StudioRoom
entity "Bookings Model" as Booking
entity "Projects Model" as Project

Owner -> HalamanRuangan : Klik hapus ruangan
HalamanRuangan -> ModalHapus : tampilkan konfirmasi hapus

alt Konfirmasi dibatalkan
    Owner -> ModalHapus : batal hapus
    ModalHapus --> HalamanRuangan : tutup modal
    HalamanRuangan --> Owner : ruangan tidak dihapus
else Konfirmasi hapus
    Owner -> ModalHapus : konfirmasi hapus
    ModalHapus -> StudioRoomController : destroy(room_code)
    StudioRoomController -> StudioRoom : SELECT studio_rooms\nberdasarkan room_code
    StudioRoom --> StudioRoomController : data ruangan
    StudioRoomController -> Booking : cek booking aktif pada room_code
    Booking --> StudioRoomController : hasil pengecekan booking
    StudioRoomController -> Project : cek project aktif melalui\nproject_schedules.room_code
    Project --> StudioRoomController : hasil pengecekan project

    alt Ruangan tidak digunakan
        StudioRoomController -> StudioRoom : DELETE/UPDATE studio_rooms\nberdasarkan room_code
        StudioRoom --> StudioRoomController : ruangan terhapus/dinonaktifkan
        StudioRoomController --> HalamanRuangan : redirect pesan berhasil
        HalamanRuangan --> Owner : ruangan berhasil dihapus
    else Ruangan masih digunakan
        StudioRoomController --> ModalHapus : tolak penghapusan
        ModalHapus --> Owner : ruangan masih digunakan
    else Ruangan tidak ditemukan / gagal hapus
        StudioRoomController --> ModalHapus : tampilkan pesan error
        ModalHapus --> Owner : proses hapus gagal
    end
end

@enduml
