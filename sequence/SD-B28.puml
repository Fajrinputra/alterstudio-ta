@startuml
title SD-B28 Menandai Hasil Final Tersedia

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Editor" as Editor
boundary "Halaman Project Editor" as HalamanProject
boundary "Form Hasil Final" as FormFinal
control "MediaAssetController" as MediaAssetController
control "NotificationService" as NotificationService
entity "Projects Model" as Project
entity "ProjectSchedules Model" as ProjectSchedule
entity "Bookings Model" as Booking
entity "Users Model" as User

Editor -> HalamanProject : Membuka daftar project
HalamanProject -> MediaAssetController : index/show(projectId)
MediaAssetController -> ProjectSchedule : ambil jadwal berdasarkan\neditor_id
ProjectSchedule -> Project : ambil project editor
Project --> ProjectSchedule : data project
ProjectSchedule --> MediaAssetController : data jadwal dan project
MediaAssetController --> HalamanProject : tampilkan kode foto dan deskripsi edit

Editor -> Editor : Mengunggah hasil final di luar sistem
Editor -> Editor : link hasil final
Editor -> FormFinal : Isi link/pesan hasil final
Editor -> FormFinal : Tandai hasil final tersedia
FormFinal -> MediaAssetController : storeFinal(projectId, finalLink, message)
MediaAssetController -> Project : ambil project
Project -> Booking : ambil booking
Booking --> Project : data booking
Project -> User : ambil klien
User --> Project : data klien
Project --> MediaAssetController : data project/booking/klien
MediaAssetController -> MediaAssetController : validasi permintaan edit tersedia
MediaAssetController -> MediaAssetController : validasi pembayaran lunas dan tidak dibatalkan
MediaAssetController -> ProjectSchedule : validasi editor sesuai jadwal
ProjectSchedule --> MediaAssetController : hasil validasi editor

alt Valid
    MediaAssetController -> Project : update final_drive_url,\nfinal_message, final_drive_uploaded_by,\nfinal_drive_uploaded_at, status FINAL
    Project --> MediaAssetController : project diperbarui
    MediaAssetController -> NotificationService : kirim notifikasi hasil final ke klien
    NotificationService --> MediaAssetController : notifikasi terkirim
    MediaAssetController --> HalamanProject : tampilkan pesan berhasil
    HalamanProject --> Editor : hasil final ditandai tersedia
else Permintaan edit belum tersedia
    MediaAssetController --> FormFinal : proses tidak dapat dilanjutkan
    FormFinal --> Editor : belum ada permintaan edit
else Pembayaran belum lunas / booking dibatalkan
    MediaAssetController --> FormFinal : proses ditolak
    FormFinal --> Editor : hasil final belum dapat ditandai
else Editor tidak sesuai
    MediaAssetController --> FormFinal : akses ditolak
    FormFinal --> Editor : tidak berhak mengubah project
end

@enduml
