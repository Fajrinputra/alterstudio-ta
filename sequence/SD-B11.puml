@startuml
title SD-B11 Lihat Dashboard

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
}

actor "Pengguna" as Pengguna
boundary "Menu Dashboard" as MenuDashboard
boundary "Halaman Dashboard" as HalamanDashboard
control "DashboardController" as DashboardController
entity "Bookings Model" as Booking
entity "Projects Model" as Project
entity "Payments Model" as Payment
entity "Users Model" as User

Pengguna -> MenuDashboard : Membuka dashboard
MenuDashboard -> HalamanDashboard : akses halaman dashboard
HalamanDashboard -> DashboardController : index()
DashboardController -> User : ambil role pengguna login
User --> DashboardController : data role
DashboardController -> Booking : ambil ringkasan pemesanan sesuai role
Booking --> DashboardController : data pemesanan
DashboardController -> Project : ambil ringkasan project sesuai role
Project --> DashboardController : data project
DashboardController -> Payment : ambil ringkasan pembayaran/pendapatan
Payment --> DashboardController : data pembayaran
DashboardController -> DashboardController : susun dashboard berdasarkan role
DashboardController --> HalamanDashboard : tampilkan dashboard
HalamanDashboard --> Pengguna : dashboard sesuai role tampil

@enduml
