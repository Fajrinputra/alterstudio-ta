@startuml
title SD-B13 Tambah Kategori Layanan

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Admin" as Admin
boundary "Halaman Kategori Layanan" as HalamanKategori
boundary "Form Tambah Kategori" as FormTambah
control "ServiceCategoryController" as CategoryController
entity "ServiceCategories Model" as ServiceCategory

Admin -> HalamanKategori : Klik tambah kategori
HalamanKategori -> FormTambah : tampilkan form tambah kategori
FormTambah --> Admin : form tampil
Admin -> FormTambah : Mengisi data kategori
Admin -> FormTambah : Klik simpan
FormTambah -> CategoryController : store(data)
CategoryController -> CategoryController : validasi data dan otorisasi

alt Data valid
    CategoryController -> ServiceCategory : create kategori layanan
    ServiceCategory --> CategoryController : kategori tersimpan
    CategoryController --> HalamanKategori : redirect dengan pesan berhasil
    HalamanKategori --> Admin : kategori baru tersimpan
else Field wajib kosong
    CategoryController --> FormTambah : tampilkan error validasi
    FormTambah --> Admin : simpan ditolak
else Gagal menyimpan
    CategoryController --> FormTambah : tampilkan pesan gagal
    FormTambah --> Admin : kategori tidak dibuat
end

@enduml
