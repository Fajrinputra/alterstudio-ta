@startuml
title SD-B31 Tambah Cabang Studio

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Owner" as Owner
boundary "Halaman Cabang Studio" as HalamanCabang
boundary "Form Tambah Cabang" as FormTambah
control "StudioLocationController" as StudioLocationController
control "StorageService" as StorageService
entity "StudioLocations Model" as StudioLocation

Owner -> HalamanCabang : Klik tambah cabang
HalamanCabang -> StudioLocationController : create()
StudioLocationController --> FormTambah : tampilkan form cabang
Owner -> FormTambah : Isi data cabang dan foto galeri
FormTambah -> StudioLocationController : store(data)
StudioLocationController -> StudioLocationController : validasi nama, alamat,\nmap_url, foto, dan status

alt Data valid
    StudioLocationController -> StudioLocationController : generate slug\notomatis dari nama cabang
    StudioLocationController -> StudioLocation : INSERT studio_locations\ndengan location_code dan slug
    StudioLocation --> StudioLocationController : cabang tersimpan
    opt Foto galeri diunggah
        StudioLocationController -> StorageService : simpan foto ke\nstorage/public/locations/{id}
        StorageService --> StudioLocationController : array path foto
        StudioLocationController -> StudioLocation : syncPhotos(paths)\nupdate kolom photo_gallery
        StudioLocation --> StudioLocationController : galeri tersimpan
    end
    StudioLocationController -> StudioLocationController : Cache::forget\n('landing.page.data.v2')
    StudioLocationController --> HalamanCabang : redirect pesan sukses
    HalamanCabang --> Owner : cabang baru tampil
else Data tidak valid / gagal simpan
    StudioLocationController --> FormTambah : tampilkan pesan error
    FormTambah --> Owner : cabang tidak tersimpan
end

@enduml
