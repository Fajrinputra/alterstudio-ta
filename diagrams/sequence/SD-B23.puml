@startuml
title SD-B23 Menandai Pelunasan di Lokasi

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Admin" as Admin
boundary "Halaman Pemesanan Admin" as HalamanAdmin
boundary "Modal Pelunasan" as ModalPelunasan
control "BookingController" as BookingController
entity "Bookings Model" as Booking
entity "Payments Model" as Payment

Admin -> HalamanAdmin : Buka menu pemesanan
HalamanAdmin -> BookingController : index()
BookingController -> Booking : ambil daftar pemesanan
Booking --> BookingController : data pemesanan
BookingController --> HalamanAdmin : tampilkan daftar pemesanan

Admin -> HalamanAdmin : Pilih pemesanan status DP
HalamanAdmin -> BookingController : show(bookingId)
BookingController -> Booking : ambil booking
Booking -> Payment : ambil pembayaran
Payment --> Booking : data pembayaran
Booking --> BookingController : data booking dan pembayaran
BookingController --> HalamanAdmin : tampilkan detail DP dan sisa pembayaran

Admin -> HalamanAdmin : Pilih aksi pelunasan
HalamanAdmin -> ModalPelunasan : tampilkan konfirmasi pelunasan
Admin -> ModalPelunasan : Klik lunas
ModalPelunasan -> BookingController : markPaidOnSite(bookingId)
BookingController -> Booking : ambil booking dan payment
Booking --> BookingController : data booking/payment
BookingController -> BookingController : validasi DP_PAID, belum lunas, tidak dibatalkan

alt Valid
    BookingController -> Booking : update status PAID
    Booking --> BookingController : booking lunas
    BookingController -> Payment : insert/update payment pelunasan manual PAID
    Payment --> BookingController : pembayaran pelunasan tercatat
    BookingController --> ModalPelunasan : tampilkan pesan berhasil
    ModalPelunasan --> Admin : status pembayaran lunas
else Belum DP / sudah lunas / dibatalkan
    BookingController --> ModalPelunasan : tampilkan pesan status tidak valid
    ModalPelunasan --> Admin : pelunasan ditolak
else Gagal menyimpan
    BookingController --> ModalPelunasan : tampilkan pesan kesalahan
    ModalPelunasan --> Admin : pelunasan gagal dicatat
end

@enduml
