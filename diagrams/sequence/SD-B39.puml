@startuml
title SD-B39 Ekspor Laporan

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Manajer" as Manajer
boundary "Halaman Laporan" as HalamanLaporan
boundary "Filter Laporan" as FilterLaporan
boundary "Tombol Ekspor" as TombolEkspor
control "ReportController" as ReportController
entity "Bookings Model" as Booking
entity "Payments Model" as Payment
entity "Projects Model" as Project
entity "Users Model" as User

Manajer -> HalamanLaporan : Membuka halaman laporan
Manajer -> FilterLaporan : Memilih periode/kategori
Manajer -> TombolEkspor : Klik ekspor CSV/PDF
TombolEkspor -> ReportController : export(filter)
ReportController -> ReportController : validasi filter dan role manajer

alt Filter valid
    ReportController -> Booking : ambil data booking
    Booking --> ReportController : data booking
    ReportController -> Payment : ambil data payment
    Payment --> ReportController : data payment
    ReportController -> Project : ambil data project
    Project --> ReportController : data project
    ReportController -> User : ambil data kru
    User --> ReportController : data kru
    ReportController -> ReportController : generate file laporan
    ReportController --> HalamanLaporan : file laporan diunduh
    HalamanLaporan --> Manajer : ekspor berhasil
else Filter tidak valid
    ReportController --> HalamanLaporan : tampilkan pesan error
    HalamanLaporan --> Manajer : ekspor ditolak
else Generate file gagal
    ReportController --> HalamanLaporan : tampilkan pesan gagal generate file
    HalamanLaporan --> Manajer : ekspor gagal
end

@enduml
