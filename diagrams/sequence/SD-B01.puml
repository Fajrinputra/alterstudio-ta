@startuml
title SD-B01 Lihat Landing Page

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
}

actor "Pengunjung/Pengguna" as Pengunjung
boundary "Landing Page" as LandingPage
control "LandingController" as LandingController
entity "LandingHeroSlides Model" as Hero
entity "ServicePackages Model" as Paket
entity "StudioLocations Model" as Cabang

Pengunjung -> LandingPage : Mengakses website Alter Studio
LandingPage -> LandingController : request landing page
LandingController -> Hero : ambil hero aktif
Hero --> LandingController : data hero
LandingController -> Paket : ambil paket aktif
Paket --> LandingController : data paket
LandingController -> Cabang : ambil cabang aktif
Cabang --> LandingController : data cabang
LandingController --> LandingPage : tampilkan landing page
LandingPage --> Pengunjung : Landing page tampil

@enduml
