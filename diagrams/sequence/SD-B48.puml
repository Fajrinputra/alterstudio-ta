@startuml
title SD-B48 Edit Ruangan Studio

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Owner" as Owner
boundary "Halaman Ruangan Studio" as HalamanRuangan
boundary "Form Edit Ruangan" as FormEdit
control "StudioRoomController" as StudioRoomController
control "StorageService" as StorageService
entity "StudioRooms Model" as StudioRoom

Owner -> HalamanRuangan : Klik edit ruangan
HalamanRuangan -> StudioRoomController : edit(roomId)
StudioRoomController -> StudioRoom : SELECT studio_rooms dan cabang
StudioRoom --> StudioRoomController : data ruangan
StudioRoomController --> FormEdit : tampilkan form edit
Owner -> FormEdit : Ubah data ruangan
Owner -> FormEdit : Klik simpan perubahan
FormEdit -> StudioRoomController : update(roomId, data)
StudioRoomController -> StudioRoomController : validasi data perubahan

alt Data valid
    opt Foto baru diunggah
        StudioRoomController -> StorageService : hapus foto lama dan simpan foto baru
        StorageService -> StorageService : DELETE old image + STORE new image
        StorageService --> StorageService : photo_path baru
        StorageService --> StudioRoomController : photo_path baru
    end
    StudioRoomController -> StudioRoom : UPDATE studio_rooms
    StudioRoom --> StudioRoomController : ruangan diperbarui
    StudioRoomController --> HalamanRuangan : redirect pesan berhasil
    HalamanRuangan --> Owner : data ruangan terbaru tampil
else Ruangan tidak ditemukan
    StudioRoomController --> HalamanRuangan : tampilkan pesan tidak ditemukan
    HalamanRuangan --> Owner : edit ditolak
else Data tidak valid / gagal simpan
    StudioRoomController --> FormEdit : tampilkan pesan error
    FormEdit --> Owner : perubahan tidak diterapkan
end

@enduml
