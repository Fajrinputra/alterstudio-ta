@startuml
title SD-B22 Pembayaran Layanan

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Klien" as Klien
boundary "Halaman Pembayaran" as HalamanPembayaran
control "BookingController" as BookingController
control "PaymentController" as PaymentController
control "MidtransService" as MidtransService
control "NotificationService" as NotificationService
entity "Bookings Model" as Booking
entity "Payments Model" as Payment

Klien -> HalamanPembayaran : Membuka daftar pemesanan
Klien -> HalamanPembayaran : Pilih pemesanan dikonfirmasi
Klien -> HalamanPembayaran : Klik lanjutkan pembayaran
HalamanPembayaran -> BookingController : pay(bookingId)
BookingController -> Booking : cek booking terkonfirmasi
Booking --> BookingController : data booking
BookingController -> Booking : set payment_started_at
Booking --> BookingController : batas waktu 30 menit dimulai
BookingController --> HalamanPembayaran : tampilkan halaman pembayaran

Klien -> HalamanPembayaran : Pilih DP 10% atau lunas
Klien -> HalamanPembayaran : Klik bayar
HalamanPembayaran -> PaymentController : createSnap(type)
PaymentController -> Booking : validasi booking dan cek payment pending
Booking --> PaymentController : data booking
PaymentController -> Payment : cek transaksi pending
Payment --> PaymentController : data payment

alt Booking belum dikonfirmasi
    PaymentController --> HalamanPembayaran : tolak pembayaran
    HalamanPembayaran --> Klien : pemesanan belum bisa dibayar
else Batas 30 menit habis
    PaymentController -> Booking : update status CANCELLED
    Booking --> PaymentController : booking dibatalkan
    PaymentController --> HalamanPembayaran : tampilkan waktu pembayaran habis
else Transaksi pending sudah ada
    PaymentController -> Payment : ambil snap token existing
    Payment --> PaymentController : snap token
    PaymentController --> HalamanPembayaran : kirim snap token
else Belum ada transaksi pending
    PaymentController -> MidtransService : create transaction
    MidtransService --> PaymentController : snap token dan order id
    PaymentController -> Payment : insert payment PENDING
    Payment --> PaymentController : payment tersimpan
    PaymentController --> HalamanPembayaran : kirim snap token
end

HalamanPembayaran --> Klien : tampilkan popup Midtrans
Klien -> MidtransService : menyelesaikan pembayaran
MidtransService -> PaymentController : webhook/confirm status
PaymentController -> Payment : update status payment
Payment --> PaymentController : payment diperbarui

alt Pembayaran DP berhasil
    PaymentController -> Booking : update status DP_PAID
    Booking --> PaymentController : booking diperbarui
else Pembayaran lunas berhasil
    PaymentController -> Booking : update status PAID
    Booking --> PaymentController : booking diperbarui
else Pembayaran gagal/kedaluwarsa
    PaymentController -> Payment : update payment FAILED/EXPIRED
    Payment --> PaymentController : transaksi diperbarui
end

PaymentController -> NotificationService : kirim notifikasi pembayaran
NotificationService --> PaymentController : notifikasi terkirim
PaymentController --> HalamanPembayaran : tampilkan status pembayaran
HalamanPembayaran --> Klien : status pembayaran tampil

@enduml
