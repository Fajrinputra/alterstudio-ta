@startuml
title SD-B38 Nonaktifkan Akun Pengguna

skinparam backgroundColor white
skinparam shadowing false
skinparam BoxPadding 4
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #999999
    LifeLineBackgroundColor white
    ParticipantBorderColor #999999
    ParticipantBackgroundColor #ECEEF8
    ParticipantFontColor #111111
    ActorBorderColor #999999
    ActorFontColor #111111
    GroupBorderColor #111111
    GroupBackgroundColor transparent
}

actor "Owner" as Owner
boundary "Halaman Kelola Pengguna" as HalamanPengguna
boundary "Kontrol Status Akun" as KontrolStatus
control "UserManagementController" as UserManagementController
entity "Users Model" as User
entity "Bookings Model" as Booking
entity "Projects Model" as Project

Owner -> HalamanPengguna : Memilih status akun
HalamanPengguna -> KontrolStatus : ubah aktif/nonaktif
KontrolStatus -> UserManagementController : toggle(userId)
UserManagementController -> User : ambil data user
User --> UserManagementController : data user
UserManagementController -> UserManagementController : cek akun owner
UserManagementController -> Booking : cek booking aktif
Booking --> UserManagementController : status booking aktif
UserManagementController -> Project : cek project aktif
Project --> UserManagementController : status project aktif

alt Akun adalah owner
    UserManagementController --> KontrolStatus : perubahan ditolak
    KontrolStatus --> Owner : owner tidak dapat dinonaktifkan
else Masih memiliki proses aktif
    UserManagementController --> KontrolStatus : perubahan ditolak
    KontrolStatus --> Owner : akun masih terkait proses aktif
else Aman diproses
    UserManagementController -> User : UPDATE users.is_active
    User --> UserManagementController : status tersimpan
    UserManagementController --> HalamanPengguna : redirect pesan sukses
    HalamanPengguna --> Owner : status akun diperbarui
end

@enduml
